            <div class="section-heading instagram-heading">

                <div>
                    <p class="eyebrow">FOLLOW OUR WORLD</p>

                    <h2>
                        @rzkyaa4_
                    </h2>
                </div>

                <a
                    href="https://www.instagram.com/rzkyaa4_/"
                    target="_blank"
                    class="text-link"
                >
                    Follow Instagram →
                </a>

            </div>

        </section>

    </main>


    <!-- CART DRAWER -->
    <aside class="cart-drawer" id="cartDrawer">

        <div class="cart-header">

            <div>
                <p class="eyebrow">YOUR BAG</p>
                <h2>Shopping Cart</h2>
            </div>

            <button id="closeCart">
                ×
            </button>

        </div>

        <div class="cart-items" id="cartItems">

            <div class="empty-cart">
                <span>♡</span>
                <p>Your cart is empty.</p>
                <small>Add your favorite scent.</small>
            </div>

        </div>

        <div class="cart-footer">

            <div class="cart-total">
                <span>Total</span>
                <strong id="cartTotal">
