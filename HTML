            <span>FRAGRANCE HOUSE</span>
        </a>

        <nav class="nav-menu">
            <a href="#home" data-id="navHome">Home</a>
            <a href="#shop" data-id="navShop">Shop</a>
            <a href="#about" data-id="navAbout">About</a>
            <a href="#promo" data-id="navPromo">Promo</a>
        </nav>

        <div class="nav-actions">

            <button class="icon-btn" id="searchBtn" aria-label="Search">
                <span>⌕</span>
            </button>

            <button class="language-btn" id="languageBtn">
                <span id="languageText">ID</span>
                <span>⌄</span>
            </button>

            <button class="icon-btn cart-btn" id="cartBtn" aria-label="Cart">
