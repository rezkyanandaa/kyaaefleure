                                onerror="imageFallback(this)"
                            >

                            <button
                                class="quick-add"
                                data-product="Éclat de Jour"
                            >
                                +
                            </button>

                        </div>

                        <div class="product-info">

                            <div>
                                <h3>Éclat de Jour</h3>
                                <p>Bergamot · Pear · White Tea</p>
