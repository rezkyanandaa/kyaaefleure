                            <img
                                src="https://images.unsplash.com/photo-1594035910387-fea47794261f?auto=format&fit=crop&w=800&q=85"
                                alt="Fleur de Rose perfume"
                                onerror="imageFallback(this)"
                            >

                            <button
                                class="quick-add"
                                data-product="Fleur de Rose"
                            >
                                +
                            </button>

                        </div>

                        <div class="product-info">

                            <div>
                                <h3>Fleur de Rose</h3>
                                <p>Rose · Peony · Musk</p>
                            </div>

                            <strong>Rp 189.000</strong>

                        </div>

                    </article>


