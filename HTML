            <div class="about-image">

                <img
                    src="https://images.unsplash.com/photo-1590156221820-47c2d2e0c7d0?auto=format&fit=crop&w=1200&q=85"
                    alt="Kyaaefleure fragrance"
                    onerror="imageFallback(this)"
                >

            </div>

            <div class="about-content">

                <p class="eyebrow">ABOUT KYAAEFLEURE</p>

                <h2>
                    A fragrance
                    <em>that feels like you.</em>
