    <link rel="stylesheet" href="style.css">
</head>

<body>

    <!-- CURSOR -->
    <div class="cursor-dot"></div>
    <div class="cursor-ring"></div>

    <!-- SPARKLE CONTAINER -->
    <div id="sparkles"></div>

    <!-- NAVBAR -->
    <header class="navbar">

        <a href="#home" class="logo">
