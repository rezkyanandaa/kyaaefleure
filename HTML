                    <a href="#about" class="text-link">
                        Discover kyaaefleure →
                    </a>

                </div>

            </div>


            <div class="hero-visual">

                <div class="hero-image-wrapper">

                    <img
                        src="https://images.unsplash.com/photo-1594035910387-fea47794261f?auto=format&fit=crop&w=1200&q=85"
                        alt="Elegant perfume bottle"
                        class="hero-image"
                        onerror="this.style.display='none'; this.parentElement.classList.add('image-fallback');"
                    >

                    <div class="hero-fallback">
                        <span>kyaaefleure</span>
                        <small>FRAGRANCE</small>
                    </div>

                </div>

                <div class="hero-note">
                    <span>01</span>
                    <p>Soft<br>Elegance</p>
                </div>

